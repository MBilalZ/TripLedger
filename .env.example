# Copy to gitignored `.env.supabase` (prod) or `.env.supabase.stage` (local testing), then:
#   pnpm setup:supabase
#   SUPABASE_ENV=stage pnpm setup:supabase
#
# Never commit real keys.
#
# Optional pooler (when db.<ref>.supabase.co is IPv6-only on your network):
#   SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
#   SUPABASE_DB_USER=postgres.<project-ref>

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — Account → Access Tokens (auth config + redirect URLs via API)
SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_HOST=
# SUPABASE_DB_USER=

# Web Push (public key also goes in apps/web/.env.local as VITE_VAPID_PUBLIC_KEY)
# Generate: npx web-push generate-vapid-keys
# Set Edge secrets: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
VITE_VAPID_PUBLIC_KEY=

# Optional browser error reporting (also as GitHub Actions secret for prod builds)
VITE_SENTRY_DSN=

# Ops-only: cron bearer for send-push (Edge + GitHub secret; never VITE_*)
# Generate: openssl rand -base64 32
PUSH_DRAIN_SECRET=
