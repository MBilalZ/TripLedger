{
  "name": "tripledger",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @tripledger/web dev --host",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @tripledger/engine test",
    "test:web": "pnpm --filter @tripledger/web test",
    "test:e2e": "pnpm --filter @tripledger/web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "sync:edge-engine": "node scripts/sync-edge-engine.mjs",
    "check:edge-engine": "node scripts/sync-edge-engine.mjs --check",
    "check:rls": "node scripts/check-rls-policies.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "pg": "^8.14.1"
  },
  "engines": {
    "node": ">=24"
  }
}
